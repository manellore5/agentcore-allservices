{
  "nodeModulesDir": "auto",
  "tasks": {
    "test": "deno test -A tests/ capstone_project/",
    "check": "deno check capstone_project/ tests/ && deno lint",
    "fmt": "deno fmt",
    "check:pins": "deno run -A scripts/check_pins.ts",
    "gateway:setup": "deno run -A capstone_project/backend/gateway/gateway_setup.ts",
    "oauth:server": "deno run -A capstone_project/backend/identity/runtime/oauth2_callback_server.ts",
    "agent:simple": "deno run -A --preload capstone_project/shared/observability.ts capstone_project/backend/runtime/simple_agent/travel_agent.ts",
    "agent:final": "deno run -A --preload capstone_project/shared/observability.ts capstone_project/backend/runtime/final_agent/unified_travel_agent.ts",
    "agent:drive": "deno run -A --preload capstone_project/shared/observability.ts capstone_project/backend/identity/runtime/travel_agent_google_drive.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "include": [
      "capstone_project/**/*.ts",
      "scripts/**/*.ts",
      "tests/**/*.ts",
      "deno.json",
      "tests/deno.json"
    ],
    "exclude": [
      "**/*.ipynb",
      "capstone_project/backend/gateway/openapi_specs/**",
      "**/environments/**"
    ],
    "lineWidth": 100
  },
  "lint": {
    "include": [
      "capstone_project/**/*.ts",
      "scripts/**/*.ts",
      "tests/**/*.ts"
    ]
  },
  "imports": {
    "@aws-crypto/sha256-js": "npm:@aws-crypto/sha256-js@5.2.0",
    "@aws-sdk/client-bedrock": "npm:@aws-sdk/client-bedrock@3.1136.0",
    "@aws-sdk/client-bedrock-agentcore": "npm:@aws-sdk/client-bedrock-agentcore@3.1136.0",
    "@aws-sdk/client-bedrock-agentcore-control": "npm:@aws-sdk/client-bedrock-agentcore-control@3.1136.0",
    "@aws-sdk/client-cloudwatch-logs": "npm:@aws-sdk/client-cloudwatch-logs@3.1136.0",
    "@aws-sdk/client-codebuild": "npm:@aws-sdk/client-codebuild@3.1136.0",
    "@aws-sdk/client-cognito-identity-provider": "npm:@aws-sdk/client-cognito-identity-provider@3.1136.0",
    "@aws-sdk/client-ecr": "npm:@aws-sdk/client-ecr@3.1136.0",
    "@aws-sdk/client-iam": "npm:@aws-sdk/client-iam@3.1136.0",
    "@aws-sdk/client-lambda": "npm:@aws-sdk/client-lambda@3.1136.0",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.1136.0",
    "@aws-sdk/client-secrets-manager": "npm:@aws-sdk/client-secrets-manager@3.1136.0",
    "@aws-sdk/client-sts": "npm:@aws-sdk/client-sts@3.1136.0",
    "@aws-sdk/credential-provider-node": "npm:@aws-sdk/credential-provider-node@3.972.83",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.30.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.1",
    "@opentelemetry/api-logs": "npm:@opentelemetry/api-logs@0.219.0",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@2.8.0",
    "@opentelemetry/core": "npm:@opentelemetry/core@2.8.0",
    "@opentelemetry/otlp-transformer": "npm:@opentelemetry/otlp-transformer@0.219.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@2.8.0",
    "@opentelemetry/sdk-logs": "npm:@opentelemetry/sdk-logs@0.219.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@2.8.0",
    "@smithy/protocol-http": "npm:@smithy/protocol-http@5.6.2",
    "@smithy/signature-v4": "npm:@smithy/signature-v4@5.7.3",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/path": "jsr:@std/path@1.1.6",
    "@strands-agents/sdk": "npm:@strands-agents/sdk@1.18.0",
    "bedrock-agentcore/": "npm:/bedrock-agentcore@0.4.4/",
    "googleapis": "npm:googleapis@181.0.0",
    "jszip": "npm:jszip@3.10.2",
    "playwright": "npm:playwright@1.63.0",
    "zod": "npm:zod@4.6.5"
  }
}
